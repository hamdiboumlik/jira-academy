# Copier ce fichier en ".env" et adapter les valeurs.

# Code secret pour créer un compte FORMATEUR (à saisir dans "Code de classe" à l'inscription)
TRAINER_CODE=change-moi-formateur

# Optionnel : si défini, les stagiaires doivent saisir ce code pour s'inscrire
CLASS_CODE=

# Clé de signature des sessions (longue chaîne aléatoire, ex : openssl rand -hex 32)
JWT_SECRET=remplace-par-une-longue-chaine-aleatoire

# Base de données
#  - vide            → SQLite local (fichier data/jira-academy.db), parfait pour tester
#  - PostgreSQL      → postgres://user:motdepasse@hote:5432/base (Neon, Supabase, Render, Railway…)
DATABASE_URL=

# Docker compose uniquement : mot de passe de la base PostgreSQL embarquée
POSTGRES_PASSWORD=jira

PORT=3000
